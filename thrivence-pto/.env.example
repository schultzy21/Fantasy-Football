# Copy this file to .env.local for local development.
# On Vercel, set these same names under Project Settings -> Environment Variables.

# Supabase project (this is where every PTO entry is stored so everyone who
# visits sees the same up-to-date calendar).
# Find these in Supabase: Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Password required to view the Leadership Summary (total PTO taken/left by
# employee, year to date). Checked server-side, never shipped to the browser.
# Change this any time by updating the value here (or in Vercel) and
# redeploying -- no code changes needed.
PTO_SUMMARY_PASSWORD=Thrivence
