# Copy this file to .env.local for local development.
# On Vercel, set these same names under Project Settings -> Environment Variables.

# Which Sleeper league to show. Baruka Ta Adenine's current league ID:
SLEEPER_LEAGUE_ID=1389331489925132288

# Supabase project (used to cache the generated weekly write-ups, and to
# log the daily injury-tracking snapshot, so every visitor sees the same
# version instead of regenerating/re-fetching on every visit).
# Find these in Supabase: Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional. If set, Vercel Cron's daily injury-tracking run must send this
# exact value as a Bearer token, so nobody else can trigger it by guessing
# the URL (low stakes either way -- it only reads public Sleeper data and
# writes to injury_events). Vercel sets this header automatically for you
# once this env var exists. Any random string works; leave blank to skip
# the check.
CRON_SECRET=

# Optional. If set, the site auto-writes power rankings blurbs, the weekly
# recap, and the predictions outlook using Claude.
# If left blank, the site instead shows a "Copy this into Claude" text
# brief you can paste yourself.
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
