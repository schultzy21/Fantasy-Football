# Copy this file to .env.local for local development.
# On Vercel, set these same names under Project Settings -> Environment Variables.

# Which Sleeper league to show. Baruka Ta Adenine's current league ID:
SLEEPER_LEAGUE_ID=1389331489925132288

# Supabase project (used to save banter quotes so they persist for everyone).
# Find these in Supabase: Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional. If set, the site auto-writes power rankings blurbs, the weekly
# recap, the predictions outlook, and a banter roast using Claude.
# If left blank, the site instead shows a "Copy this into Claude" text
# brief you can paste yourself. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
