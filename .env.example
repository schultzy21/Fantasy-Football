# Copy this file to .env.local for local development.
# On Vercel, set these same names under Project Settings -> Environment Variables.

# Which Sleeper league to show. Baruka Ta Adenine's current league ID:
SLEEPER_LEAGUE_ID=1389331489925132288

# Supabase project (used to cache the generated weekly write-ups so every
# visitor sees the same version instead of regenerating on every visit).
# Find these in Supabase: Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional. If set, the site auto-writes power rankings blurbs, the weekly
# recap, the predictions outlook, and (via a weekly scheduled job) the
# newsletter using Claude, including a web search for real NFL news.
# If left blank, the site instead shows a "Copy this into Claude" text
# brief you can paste yourself, and the newsletter won't publish.
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional. If set, Vercel Cron's automatic weekly newsletter run must send
# this exact value as a Bearer token, so nobody else can trigger it (and
# spend your Anthropic credits) by guessing the URL. Vercel sets this header
# automatically for you once this env var exists -- you don't configure
# anything else. Any random string works; leave blank to skip the check.
CRON_SECRET=
